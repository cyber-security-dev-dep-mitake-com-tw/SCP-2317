<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="SCP-2317"
    Manufacturer="SCP-2317 Email Protection"
    Version="0.2.0"
    UpgradeCode="{D7E6C3D2-6A6B-42D0-83E3-4B2B5E5FD5B1}">
    <MajorUpgrade DowngradeErrorMessage="A newer version of SCP-2317 is already installed." />
    <MediaTemplate />
    <Icon Id="AppIcon" SourceFile="$(var.LogoIcoPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Feature Id="MainFeature" Title="SCP-2317" Level="1">
      <ComponentGroupRef Id="SCP2317Components" />
    </Feature>

    <CustomAction
      Id="RegisterOutlookComAddin"
      Directory="INSTALLFOLDER"
      ExeCommand="[SystemFolder]regsvr32.exe /s &quot;[#SCP2317OutlookAddinDll]&quot;"
      Execute="deferred"
      Return="check"
      Impersonate="yes" />
    <CustomAction
      Id="UnregisterOutlookComAddin"
      Directory="INSTALLFOLDER"
      ExeCommand="[SystemFolder]regsvr32.exe /u /s &quot;[#SCP2317OutlookAddinDll]&quot;"
      Execute="deferred"
      Return="ignore"
      Impersonate="yes" />
    <!-- Start the silent service immediately after install (fire-and-forget). -->
    <CustomAction
      Id="StartService"
      FileRef="SCP2317ApiExe"
      ExeCommand=""
      Execute="deferred"
      Return="asyncNoWait"
      Impersonate="no" />
    <!-- Stop the service before its files are removed on uninstall. -->
    <CustomAction
      Id="StopService"
      Directory="INSTALLFOLDER"
      ExeCommand="[SystemFolder]taskkill.exe /f /im scp2317-api.exe"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />
    <InstallExecuteSequence>
      <Custom Action="RegisterOutlookComAddin" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="StartService" After="RegisterOutlookComAddin" Condition="NOT Installed" />
      <Custom Action="StopService" Before="UnregisterOutlookComAddin" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnregisterOutlookComAddin" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SCP-2317" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="SCP2317Components" Directory="INSTALLFOLDER">
      <Component Id="SCP2317ApiComponent" Guid="{A5C49D62-0D2B-4F3B-9E0F-7D8F3A0D6B6A}">
        <File Id="SCP2317ApiExe" Source="$(var.ApiBinaryPath)" KeyPath="yes" />
        <!-- Autostart the silent background service for all users at logon. -->
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="SCP-2317"
                       Type="string"
                       Value="&quot;[#SCP2317ApiExe]&quot;" />
      </Component>
      <Component Id="SCP2317OutlookAddinComponent" Guid="{E2B0A7F5-735B-4F6F-A03F-50E350C2B47B}">
        <File Id="SCP2317OutlookAddinDll" Source="$(var.AddinDllPath)" KeyPath="yes" />
      </Component>
      <Component Id="SCP2317IconComponent" Guid="{B1C2D3E4-5F60-4A71-8B92-0C1D2E3F4A5B}">
        <File Source="$(var.LogoIcoPath)" Name="scp2317.ico" />
      </Component>
      <Component Id="SCP2317LogoComponent" Guid="{C2D3E4F5-6071-4B82-9C03-1D2E3F4A5B6C}">
        <File Source="$(var.LogoPngPath)" Name="logo.png" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
