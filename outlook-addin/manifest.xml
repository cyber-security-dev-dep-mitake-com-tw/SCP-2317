<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
  <Id>5ba93686-a318-4d95-9d75-0f5d77eedabb</Id>
  <Version>0.2.0.0</Version>
  <ProviderName>SCP-2317 Development</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SCP-2317 Email Scanner"/>
  <Description DefaultValue="Scans the selected email with an authorized SCP-2317 service."/>
  <IconUrl DefaultValue="https://localhost:3000/icon-64.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/support.html"/>
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
    <AppDomain>http://127.0.0.1:8080</AppDomain>
    <AppDomain>http://localhost:8080</AppDomain>
  </AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.8"/></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead"><DesktopSettings><SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/><RequestedHeight>250</RequestedHeight></DesktopSettings></Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/></Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets>
        <bt:Set Name="Mailbox" MinVersion="1.8"/>
      </bt:Sets>
    </Requirements>
    <FormSettings>
      <Form xsi:type="ItemRead">
        <DesktopSettings>
          <SourceLocation resid="Taskpane.Url"/>
          <RequestedHeight>250</RequestedHeight>
        </DesktopSettings>
      </Form>
    </FormSettings>
    <Permissions>ReadItem</Permissions>
    <Rule xsi:type="RuleCollection" Mode="Or">
      <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    </Rule>
    <DisableEntityHighlighting>false</DisableEntityHighlighting>

    <!--
      Ribbon commands below use CustomTab, which Outlook only renders on
      classic Outlook desktop for Windows (Win32/MSI). Outlook on the web,
      new Outlook on Windows, and Outlook on Mac ignore CustomTab; on those
      clients this add-in still works via the ItemRead taskpane form above,
      just without the dedicated ribbon tab shown here.
      https://learn.microsoft.com/javascript/api/manifest/customtab
    -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets>
          <bt:Set Name="Mailbox" MinVersion="1.8"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <CustomTab id="SCP2317.TabScan">
                <Group id="SCP2317.ScanGroup">
                  <Label resid="GroupLabel"/>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>

                  <Control xsi:type="Button" id="SCP2317.OpenTaskpaneButton">
                    <Label resid="OpenTaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="OpenTaskpaneButton.Label"/>
                      <Description resid="OpenTaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>

                  <Control xsi:type="Button" id="SCP2317.QuickScanButton">
                    <Label resid="QuickScanButton.Label"/>
                    <Supertip>
                      <Title resid="QuickScanButton.Label"/>
                      <Description resid="QuickScanButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>onQuickScan</FunctionName>
                    </Action>
                  </Control>

                  <Control xsi:type="Button" id="SCP2317.ReportSuspiciousButton">
                    <Label resid="ReportSuspiciousButton.Label"/>
                    <Supertip>
                      <Title resid="ReportSuspiciousButton.Label"/>
                      <Description resid="ReportSuspiciousButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>onReportSuspicious</FunctionName>
                    </Action>
                  </Control>

                  <Control xsi:type="Menu" id="SCP2317.MoreMenu">
                    <Label resid="MoreMenu.Label"/>
                    <Supertip>
                      <Title resid="MoreMenu.Label"/>
                      <Description resid="MoreMenu.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Items>
                      <Item id="SCP2317.MoreMenu.CheckStatus">
                        <Label resid="CheckStatusItem.Label"/>
                        <Supertip>
                          <Title resid="CheckStatusItem.Label"/>
                          <Description resid="CheckStatusItem.Tooltip"/>
                        </Supertip>
                        <Icon>
                          <bt:Image size="16" resid="Icon.16x16"/>
                          <bt:Image size="32" resid="Icon.32x32"/>
                          <bt:Image size="80" resid="Icon.80x80"/>
                        </Icon>
                        <Action xsi:type="ExecuteFunction">
                          <FunctionName>onCheckStatus</FunctionName>
                        </Action>
                      </Item>
                      <Item id="SCP2317.MoreMenu.About">
                        <Label resid="AboutItem.Label"/>
                        <Supertip>
                          <Title resid="AboutItem.Label"/>
                          <Description resid="AboutItem.Tooltip"/>
                        </Supertip>
                        <Icon>
                          <bt:Image size="16" resid="Icon.16x16"/>
                          <bt:Image size="32" resid="Icon.32x32"/>
                          <bt:Image size="80" resid="Icon.80x80"/>
                        </Icon>
                        <Action xsi:type="ExecuteFunction">
                          <FunctionName>onShowAbout</FunctionName>
                        </Action>
                      </Item>
                    </Items>
                  </Control>
                </Group>
                <Label resid="TabLabel"/>
              </CustomTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="TabLabel" DefaultValue="SCP-2317"/>
          <bt:String id="GroupLabel" DefaultValue="Email Protection"/>
          <bt:String id="OpenTaskpaneButton.Label" DefaultValue="Scan &amp; Report"/>
          <bt:String id="QuickScanButton.Label" DefaultValue="Quick Scan"/>
          <bt:String id="ReportSuspiciousButton.Label" DefaultValue="Report Suspicious"/>
          <bt:String id="MoreMenu.Label" DefaultValue="SCP-2317 Endpoint"/>
          <bt:String id="CheckStatusItem.Label" DefaultValue="Check API Status"/>
          <bt:String id="AboutItem.Label" DefaultValue="About SCP-2317"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="OpenTaskpaneButton.Tooltip" DefaultValue="Open the full SCP-2317 scan report for this message."/>
          <bt:String id="QuickScanButton.Tooltip" DefaultValue="Run a fast heuristic scan and show the verdict inline, without opening the task pane."/>
          <bt:String id="ReportSuspiciousButton.Tooltip" DefaultValue="Scan this message and record a sandbox job (never executed) for follow-up."/>
          <bt:String id="MoreMenu.Tooltip" DefaultValue="SCP-2317 endpoint status and add-in information."/>
          <bt:String id="CheckStatusItem.Tooltip" DefaultValue="Ping the SCP-2317 scan API and show whether it is reachable."/>
          <bt:String id="AboutItem.Tooltip" DefaultValue="Show the SCP-2317 add-in version and scope."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
